+/*
+ * Per-process RNDR/RNDRRS interception (record-and-replay).
+ * Entry in the per-VM hash table of guest TTBR0_EL1 base addresses whose
+ * EL0 RNDR/RNDRRS reads should trap to the guest as UNDEF (delivered as
+ * SIGILL) rather than being emulated.  Keyed by the page-table base
+ * of the monitored process.  TTBR0 ASID bits [63:48] are masked off
+ * before comparison; see RR_TTBR0_BADDR_MASK.
+ */
+#define RR_TTBR0_BADDR_MASK	GENMASK_ULL(47, 1)
+
+struct kvm_rr_monitored_ttbr0 {
+	struct hlist_node node;
+	unsigned long ttbr0;
+};
+
+long kvm_rr_register_ttbr0(struct kvm *kvm, unsigned long ttbr0);
+long kvm_rr_deregister_ttbr0(struct kvm *kvm, unsigned long ttbr0);
+bool kvm_rr_ttbr0_is_monitored(struct kvm *kvm, unsigned long ttbr0);
+void kvm_rr_destroy(struct kvm *kvm);
+
 struct kvm_arch {
 	struct kvm_s2_mmu mmu;
 
 	/*
+	 * Per-process RNDR/RNDRRS interception: hash table of monitored
+	 * guest TTBR0_EL1 base addresses, populated by the guest module via
+	 * the RR vendor hypercalls.  Protected by rr_monitored_lock.
+	 */
+#define KVM_RR_MON_HT_BITS	6
+	DECLARE_HASHTABLE(rr_monitored_ttbr0s, KVM_RR_MON_HT_BITS);
+	spinlock_t rr_monitored_lock;
+
+	/*
 	 * Fine-Grained UNDEF, mimicking the FGT layout defined by the
 	 * architecture. We track them globally, as we present the
 	 * same feature-set to all vcpus.
Index: linux-6.12.88/arch/arm64/kvm/arm.c
===================================================================
--- linux-6.12.88.orig/arch/arm64/kvm/arm.c
+++ linux-6.12.88/arch/arm64/kvm/arm.c
@@ -167,12 +167,109 @@ static int kvm_arm_default_max_vcpus(voi
  * @kvm:	pointer to the KVM struct
  * @type:	kvm device type
  */
+/*
+ * Per-process RNDR/RNDRRS interception (record-and-replay).
+ *
+ * The guest module registers the TTBR0_EL1 base address of each monitored
+ * process via the RR vendor hypercalls (see hypercalls.c).  When an EL0
+ * RNDR/RNDRRS read is forwarded from EL3 and lands in access_rng()
+ * (sys_regs.c), the handler checks whether the current TTBR0 is in this set
+ * and, if so, injects UNDEF instead of emulating.  One table per VM,
+ * not per vCPU.  TTBR0 values are stored already masked with
+ * RR_TTBR0_BADDR_MASK; callers must mask before lookup.
+ */
+long kvm_rr_register_ttbr0(struct kvm *kvm, unsigned long ttbr0)
+{
+	struct kvm_rr_monitored_ttbr0 *entry;
+
+	ttbr0 &= RR_TTBR0_BADDR_MASK;
+
+	spin_lock(&kvm->arch.rr_monitored_lock);
+	hash_for_each_possible(kvm->arch.rr_monitored_ttbr0s, entry, node,
+			       ttbr0) {
+		if (entry->ttbr0 == ttbr0) {
+			spin_unlock(&kvm->arch.rr_monitored_lock);
+			return SMCCC_RET_INVALID_PARAMETER; /* already there */
+		}
+	}
+	spin_unlock(&kvm->arch.rr_monitored_lock);
+
+	entry = kmalloc(sizeof(*entry), GFP_KERNEL_ACCOUNT);
+	if (!entry)
+		return SMCCC_RET_NOT_SUPPORTED;
+
+	entry->ttbr0 = ttbr0;
+
+	spin_lock(&kvm->arch.rr_monitored_lock);
+	hash_add(kvm->arch.rr_monitored_ttbr0s, &entry->node, ttbr0);
+	spin_unlock(&kvm->arch.rr_monitored_lock);
+
+	return SMCCC_RET_SUCCESS;
+}
+
+long kvm_rr_deregister_ttbr0(struct kvm *kvm, unsigned long ttbr0)
+{
+	struct kvm_rr_monitored_ttbr0 *entry;
+
+	ttbr0 &= RR_TTBR0_BADDR_MASK;
+
+	spin_lock(&kvm->arch.rr_monitored_lock);
+	hash_for_each_possible(kvm->arch.rr_monitored_ttbr0s, entry, node,
+			       ttbr0) {
+		if (entry->ttbr0 == ttbr0) {
+			hash_del(&entry->node);
+			spin_unlock(&kvm->arch.rr_monitored_lock);
+			kfree(entry);
+			return SMCCC_RET_SUCCESS;
+		}
+	}
+	spin_unlock(&kvm->arch.rr_monitored_lock);
+
+	return SMCCC_RET_INVALID_PARAMETER; /* not found */
+}
+
+bool kvm_rr_ttbr0_is_monitored(struct kvm *kvm, unsigned long ttbr0)
+{
+	struct kvm_rr_monitored_ttbr0 *entry;
+	bool found = false;
+
+	spin_lock(&kvm->arch.rr_monitored_lock);
+	hash_for_each_possible(kvm->arch.rr_monitored_ttbr0s, entry, node,
+			       ttbr0) {
+		if (entry->ttbr0 == ttbr0) {
+			found = true;
+			break;
+		}
+	}
+	spin_unlock(&kvm->arch.rr_monitored_lock);
+
+	return found;
+}
+
+void kvm_rr_destroy(struct kvm *kvm)
+{
+	struct kvm_rr_monitored_ttbr0 *entry;
+	struct hlist_node *tmp;
+	int bkt;
+
+	spin_lock(&kvm->arch.rr_monitored_lock);
+	hash_for_each_safe(kvm->arch.rr_monitored_ttbr0s, bkt, tmp, entry,
+			   node) {
+		hash_del(&entry->node);
+		kfree(entry);
+	}
+	spin_unlock(&kvm->arch.rr_monitored_lock);
+}
+
 int kvm_arch_init_vm(struct kvm *kvm, unsigned long type)
 {
 	int ret;
 
 	mutex_init(&kvm->arch.config_lock);
 
+	hash_init(kvm->arch.rr_monitored_ttbr0s);
+	spin_lock_init(&kvm->arch.rr_monitored_lock);
+
 #ifdef CONFIG_LOCKDEP
 	/* Clue in lockdep that the config_lock must be taken inside kvm->lock */
 	mutex_lock(&kvm->lock);
@@ -271,6 +368,8 @@ void kvm_arch_destroy_vm(struct kvm *kvm
 	kvm_unshare_hyp(kvm, kvm + 1);
 
 	kvm_arm_teardown_hypercalls(kvm);
+
+	kvm_rr_destroy(kvm);
 }
 
