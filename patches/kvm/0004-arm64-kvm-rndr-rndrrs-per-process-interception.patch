@@ -534,6 +534,27 @@ static bool access_rng(struct kvm_vcpu *
 	pr_info_once("kvm: rng-trap: RNDR%s trap forwarded from EL3 caught\n",
 		     r->Op2 == 1 ? "RS" : "");
 
+	/*
+	 * Per-process interception (record-and-replay).  Only
+	 * user-mode (EL0) reads from a monitored address space are
+	 * intercepted; the process is identified by TTBR0_EL1 with the ASID
+	 * masked off (its page-table base).  A monitored EL0 read gets
+	 * an UNDEF injected, so the guest kernel delivers
+	 * SIGILL to the tracee, where a replay supervisor substitutes a
+	 * recorded value.  Guest-kernel (EL1+) reads and unmonitored EL0
+	 * reads fall through to transparent emulation, leaving the rest
+	 * of the system untouched.
+	 */
+	if (!vcpu_mode_priv(vcpu)) {
+		unsigned long ttbr0 = vcpu_read_sys_reg(vcpu, TTBR0_EL1) &
+				      RR_TTBR0_BADDR_MASK;
+
+		if (kvm_rr_ttbr0_is_monitored(vcpu->kvm, ttbr0)) {
+			kvm_inject_undefined(vcpu);
+			return false;
+		}
+	}
+
 	if (__cpu_has_rng()) {
 		if (r->Op2 == 1)
 			ok = __arm64_rndrrs(&val);
