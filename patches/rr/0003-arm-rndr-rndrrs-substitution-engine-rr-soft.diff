+// rr-entropy-monitor guest module control device ABI (mirrors
+// guest-module/rr_entropy_monitor.h in this artifact).
+#define RRMON_DEVICE_PATH "/dev/rr-entropy-monitor"
+#define RRMON_IOC_MAGIC 0xE7
+#define RRMON_IOC_REGISTER _IOW(RRMON_IOC_MAGIC, 1, int32_t)
+#define RRMON_IOC_DEREGISTER _IOW(RRMON_IOC_MAGIC, 2, int32_t)
+
+static bool rrmon_ioctl_tid(unsigned long cmd, pid_t tid) {
+  int fd = open(RRMON_DEVICE_PATH, O_RDWR | O_CLOEXEC);
+  if (fd < 0) {
+    return false;
+  }
+  int32_t pid = tid;
+  int ret = ioctl(fd, cmd, &pid);
+  close(fd);
+  return ret >= 0;
+}
+
+bool rrmon_register_tid(pid_t tid) {
+  return rrmon_ioctl_tid(RRMON_IOC_REGISTER, tid);
+}
+
+bool rrmon_deregister_tid(pid_t tid) {
+  return rrmon_ioctl_tid(RRMON_IOC_DEREGISTER, tid);
+}
