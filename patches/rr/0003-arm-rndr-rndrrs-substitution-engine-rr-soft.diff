+/**
+ * Return true if |t| was stopped because of a SIGILL from a monitored
+ * RNDR/RNDRRS instruction (the rr-entropy-monitor module makes KVM inject
+ * UNDEF -> SIGILL for a registered process) and |t| was updated
+ * appropriately.
+ *
+ * We substitute a fresh entropy value into the destination register, set
+ * NZCV = 0b0000 (architected success), advance past the instruction, and
+ * record an instruction_trap event.  The value rides in the recorded
+ * register state, so replay reproduces it deterministically via
+ * set_regs(trace_frame.regs()) -- no separate trace event is needed (cf.
+ * how CNTVCT/RDTSC are handled).
+ */
+static bool try_handle_rndr_trap(RecordTask* t, siginfo_t* si) {
+  ASSERT(t, si->si_signo == SIGILL);
+
+  auto special = special_instruction_at(t, t->ip());
+  if (special.opcode != SpecialInstOpcode::ARM_MRS_RNDR &&
+      special.opcode != SpecialInstOpcode::ARM_MRS_RNDRRS) {
+    return false;
+  }
+
+  uint64_t value = 0;
+  good_random(&value, sizeof(value));
+
+  Registers r = t->regs();
+  if (special.regno != 31) {  // Rt == 31 encodes XZR: the write is discarded
+    r.set_x(special.regno, value);
+  }
+  r.set_nzcv(0);  // success
+
+  r.set_ip(r.ip() + special_instruction_len(special.opcode));
+  t->set_regs(r);
+
+  LOG(debug) << " trapped for "
+             << (special.opcode == SpecialInstOpcode::ARM_MRS_RNDR ? "rndr"
+                                                                   : "rndrrs")
+             << ": x" << special.regno << " -> " << HEX(value);
+
+  t->record_event(Event::instruction_trap());
+  t->push_event(Event::noop());
+  return true;
+}
